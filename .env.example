# =============================================================================
# Business Inventory Management System -- Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_ADMIN_EMAIL=admin@bizflow.com
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-admin-password


# --- Database ----------------------------------------------------------------
# Option A: Supabase PostgreSQL (Recommended for production)
# Direct connection (port 5432 - for migrations and persistent servers):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543 - for high-concurrency / serverless):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# DB_IS_POOLER=True
#
# Option B: Local/Self-hosted PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/bizflow_db
#
# Option C: Legacy MySQL credentials
# MYSQL_USER=your_db_user
# MYSQL_PASSWORD=your_db_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=inventory_db

# --- Production Security & Domains -------------------------------------------
# Comma-separated domains allowed to serve requests
# ALLOWED_HOSTS=bizflow.yourdomain.com,api.yourdomain.com
#
# Comma-separated origins for Django CSRF protection (HTTPS required in prod)
# CSRF_TRUSTED_ORIGINS=https://bizflow.yourdomain.com,https://*.yourdomain.com
#
# Comma-separated origins allowed for FastAPI / API requests
# CORS_ALLOWED_ORIGINS=https://bizflow.yourdomain.com,app://desktop,app://mobile


# --- Email (SMTP) ------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=noreply@inventory.com

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Supabase Auth (Optional - for unified cloud authentication) --------------
# Found in Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- FastAPI / JWT -----------------------------------------------------------
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI Integration (future) -------------------------------------------------
AI_API_KEY=

# --- File Storage ------------------------------------------------------------
# Local media root (Django). For production, use S3/cloud storage.
MEDIA_ROOT=media
MEDIA_URL=/media/

# Canonical site URL for sitemap and SEO metadata
SITE_URL=http://localhost:8000
