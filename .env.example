# =============================================================================
# Business Inventory Management System -- Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Option A: Full URL (takes precedence over individual vars)
# DATABASE_URL=mysql+mysqlconnector://user:pass@localhost:3306/inventory_db

# Option B: Individual MySQL credentials
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=inventory_db

# --- Email (SMTP) ------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=noreply@inventory.com

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- FastAPI / JWT -----------------------------------------------------------
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI Integration (future) -------------------------------------------------
AI_API_KEY=

# --- File Storage ------------------------------------------------------------
# Local media root (Django). For production, use S3/cloud storage.
MEDIA_ROOT=media
MEDIA_URL=/media/

# Canonical site URL for sitemap and SEO metadata
SITE_URL=http://localhost:8000
